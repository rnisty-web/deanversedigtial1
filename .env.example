# Site
NEXT_PUBLIC_SITE_URL=https://www.deanversedigital.com

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=https://www.deanversedigital.com/auth/callback

# Email (contact form notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_FORM_TO=

# Admin bootstrap
ADMIN_OWNER_EMAIL=

# Bot protection (required in production for /api/leads)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limiting (recommended for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe (optional — client portal invoices)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
